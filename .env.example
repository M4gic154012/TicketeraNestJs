# Entorno
NODE_ENV=development
LOG_LEVEL=debug

# Puertos: el gateway es el único con HTTP expuesto; el resto habla TCP interno.
GATEWAY_HTTP_PORT=3000
BFF_WEB_TCP_PORT=4001
USERS_TCP_PORT=4101
TICKETS_TCP_PORT=4102
NOTIFICATIONS_TCP_PORT=4103

# Hosts internos. En local, 127.0.0.1; en Docker, el nombre del servicio.
BFF_WEB_HOST=127.0.0.1
USERS_HOST=127.0.0.1
TICKETS_HOST=127.0.0.1
NOTIFICATIONS_HOST=127.0.0.1

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ticketera
DB_PASSWORD=cambiar_en_local
DB_NAME=ticketera
DB_SSL=false
DB_POOL_MAX=10
DB_LOGGING=false

# Auth. Generá UN SECRETO DISTINTO POR ENTORNO con:
#   openssl rand -base64 48
# Nunca reutilices el valor de este ejemplo ni el de otro entorno: con el secreto
# se pueden forjar tokens de cualquier usuario y rol.
JWT_SECRET=reemplazar_por_un_secreto_de_al_menos_32_caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# Secreto compartido entre gateway, BFF y microservicios. DISTINTO del de JWT:
# que se filtre uno no debe comprometer al otro. Generalo igual que el anterior.
RPC_SHARED_SECRET=reemplazar_por_otro_secreto_de_al_menos_32_caracteres

# Interfaz donde escuchan los microservicios.
#   127.0.0.1 en local (no los expone a la red)
#   0.0.0.0   en Docker Compose (el aislamiento lo da la red del compose)
MICROSERVICE_BIND_HOST=127.0.0.1

# Publica Swagger en /api/docs. Dejalo en false salvo en desarrollo local.
ENABLE_SWAGGER=false

# Borde
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Circuit breaker
CB_TIMEOUT_MS=3000
CB_FAILURE_THRESHOLD_PCT=50
CB_RESET_TIMEOUT_MS=15000

# Respaldos (scripts/backup.sh)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# Días que se conservan las notificaciones ya leídas (las no leídas nunca se borran)
NOTIFICATION_RETENTION_DAYS=90

# SLA por prioridad, en minutos
SLA_CRITICAL_MINUTES=60
SLA_HIGH_MINUTES=240
SLA_MEDIUM_MINUTES=1440
SLA_LOW_MINUTES=4320

# --- Ingesta de tickets por correo -----------------------------------------
# Interruptor general. Dejalo en true para probar.
MAIL_INGESTION_ENABLED=false
# 'simulado' lee archivos .eml de un directorio (para probar sin la cuenta creada).
# 'imap' se conecta al buzón real.
MAIL_ADAPTER=simulado
MAIL_ADDRESS=soporte@cmm.uchile.cl
MAIL_ALLOWED_DOMAINS=uchile.cl
MAIL_POLL_BATCH_SIZE=25
MAIL_SIMULATED_DIR=./correos-prueba

# IMAP (cuando soporte@cmm.uchile.cl exista).
# Google Workspace exige una CONTRASEÑA DE APLICACIÓN de 16 caracteres: la
# contraseña normal de la cuenta no funciona para IMAP.
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=soporte@cmm.uchile.cl
MAIL_IMAP_PASSWORD=
MAIL_IMAP_MAILBOX=INBOX

# Documentación interactiva en /api/docs.
# En producción, con ENABLE_SWAGGER=true hay que definir las credenciales: el esquema
# las exige y el gateway no arranca sin ellas, así que /api/docs no puede quedar
# público por un olvido. La contraseña necesita 12 caracteres como mínimo.
SWAGGER_USER=usuario_de_la_doc
SWAGGER_PASSWORD=reemplazar_por_una_contrasena_de_12_o_mas
