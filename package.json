{
  "name": "ticketera",
  "version": "0.1.0",
  "description": "Backend de mesa de ayuda (ticketera) en NestJS: API Gateway + BFF + microservicios sobre PostgreSQL",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "rimraf dist && nest build api-gateway && nest build bff-web && nest build users-service && nest build tickets-service && nest build notifications-service && nest build email-ingestion-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\" --fix",
    "start:gateway": "nest start api-gateway --watch",
    "start:bff": "nest start bff-web --watch",
    "start:users": "nest start users-service --watch",
    "start:tickets": "nest start tickets-service --watch",
    "start:notifications": "nest start notifications-service --watch",
    "start:dev": "concurrently -n gateway,bff,users,tickets,notif,email -c cyan,magenta,green,yellow,blue,white \"npm:start:gateway\" \"npm:start:bff\" \"npm:start:users\" \"npm:start:tickets\" \"npm:start:notifications\" \"npm:start:email\"",
    "db:up": "docker compose --env-file .env -f docker/docker-compose.yml up -d postgres",
    "db:down": "docker compose --env-file .env -f docker/docker-compose.yml down",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d libs/database/src/data-source.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d libs/database/src/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register libs/database/src/seeds/run-seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "migration:show": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:show -d libs/database/src/data-source.ts",
    "db:backup": "bash scripts/backup.sh",
    "db:restore": "bash scripts/restore.sh",
    "docker:up": "docker compose --env-file .env -f docker/docker-compose.yml up -d --build",
    "docker:down": "docker compose --env-file .env -f docker/docker-compose.yml down",
    "docker:migrate": "docker compose --env-file .env -f docker/docker-compose.yml run --rm migrator",
    "docker:logs": "docker compose --env-file .env -f docker/docker-compose.yml logs -f --tail=50",
    "lint:ci": "eslint \"{apps,libs,test}/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc -p tsconfig.build.json --noEmit --incremental false",
    "start:email": "nest start email-ingestion-service --watch",
    "user:create": "ts-node -r tsconfig-paths/register apps/users-service/src/cli/create-user.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "imapflow": "^2.0.2",
    "joi": "^17.13.3",
    "mailparser": "^3.9.26",
    "nestjs-pino": "^4.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@ticketera/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@ticketera/database(|/.*)$": "<rootDir>/libs/database/src/$1",
      "^@ticketera/patterns(|/.*)$": "<rootDir>/libs/patterns/src/$1"
    }
  },
  "overrides": {
    "multer": "^2.3.0",
    "tar": "^7.5.22"
  }
}
